# Set these in the hosting dashboard, or pass this file explicitly to docker --env-file.
# Spring Boot does not load a .env file automatically.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:mysql://YOUR_PRIVATE_DB_HOST:3306/YOUR_DATABASE?serverTimezone=Asia/Bangkok
DB_USERNAME=YOUR_APP_DATABASE_USER
DB_PASSWORD=
# Use update only for the first schema initialization, then change to validate.
DB_DDL_AUTO=validate
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
# Set separate stable random values, each at least 32 characters. Do not commit them.
JWT_SECRET=
MAIL_ENCRYPTION_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Copy to application-local.properties, which is excluded from Git and Docker.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/ce_system_db?createDatabaseIfNotExist=true&serverTimezone=Asia/Bangkok
spring.datasource.username=YOUR_LOCAL_DATABASE_USER
spring.datasource.password=YOUR_LOCAL_DATABASE_PASSWORD
app.jwt.secret=REPLACE_WITH_A_STABLE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
app.mail.encryption-key=REPLACE_WITH_A_DIFFERENT_STABLE_RANDOM_SECRET
app.brevo.api-key=YOUR_BREVO_API_KEY
app.brevo.sender-email=YOUR_VERIFIED_SENDER_EMAIL
